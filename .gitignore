# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C & build artifacts
build/
dist/
*.egg-info/

# Environments & Secrets (NEVER commit secrets or API keys)
.env
.env.local
.env.*.local
.venv/
venv/
ENV/
env/
video/

# AI Agent Framework & IDE state
.agents/
.gemini/
.claude/
scratch/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
*.log

# Local SQLite databases and runtime storage
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.db
*.db-wal
*.db-shm
*.sqlite
data/*.sqlite3*
data/*.db*
data/*.sqlite*
!data/.gitkeep

# Export artifacts generated from runs
exports/*
!exports/.gitkeep

# IDE, editor & OS files
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.temp
*.bak
