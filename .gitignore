# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C & build artifacts
build/
dist/
*.egg-info/

# Environments & Secrets (NEVER commit secrets or API keys)
.env
.venv/
venv/
ENV/
env/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Local SQLite databases and runtime storage
*.sqlite3
*.db
*.sqlite
data/*.sqlite3
data/*.db
data/*.sqlite
!data/.gitkeep

# Export artifacts generated from runs
exports/*
!exports/.gitkeep

# IDE, editor & OS files
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Ignore all markdown files except README.md
*.md
**/*.md
!README.md
!**/README.md
