# DataHunt Environment Configuration
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_TEMPERATURE=0.1
DATAHUNT_API_KEY=

DATABASE_PATH=./data/datahunt.sqlite3
EXPORT_DIR=./exports

MAX_RUN_SECONDS=300
MAX_SEARCH_QUERIES=12
MAX_PAGES_FETCHED=40
MAX_BROWSER_PAGES=8
MAX_RESPONSE_BYTES=2000000
MAX_RECORDS=250
MAX_TOOL_STEPS=30
MAX_CONCURRENT_RUNS=2

# Optional FreeHire public job catalogue (MIT/open-source project)
FREEHIRE_ENABLED=true
FREEHIRE_API_URL=https://freehire.me/api/v1
FREEHIRE_API_KEY=
FREEHIRE_MAX_REQUESTS_PER_RUN=20

# Brave Search API — free tier (2000 req/month), real SERP; fallback when DuckDuckGo rate-limits
# Get key at: https://brave.com/search/api/
BRAVE_API_KEY=
# Serper.dev — Google Search API (2500 free queries/month, no CC): https://serper.dev
SERPER_API_KEY=
# Tavily Search — AI-optimized (1000 free queries/month, no CC): https://tavily.com
TAVILY_API_KEY=

LOG_LEVEL=INFO
